# Optional overrides — webroot-mcp has no required env vars.
# Authentication is per-request via five request headers, matching MSPbots'
# own stored credential fields for this integration (Webroot's Unity API,
# GSM/Global Site Manager console access):
#   X-Webroot-Username — the GSM console user's email
#   X-Webroot-Password — the corresponding password
#   X-Webroot-Client-Id — Unity API client ID (contact Webroot to obtain)
#   X-Webroot-Client-Secret — Unity API client secret
#   X-Webroot-Parent-Keycode — the GSM console's parent key code
#
# This server performs a fresh OAuth2 "password" grant on every single
# tool call:
#   POST https://unityapi.webrootcloudav.com/auth/token
#     grant_type=password&username=...&password=...&client_id=...&client_secret=...&scope=Console.GSM SkyStatus.GSM
#   -> {"access_token": "...", "expires_in": 299, ...}
# The access_token (valid only ~5 minutes) is then sent as
# "Authorization: Bearer <token>" on the real API call. Nothing is cached
# or persisted across MCP calls.

MCP_HTTP_PORT=8080
MCP_HTTP_HOST=0.0.0.0
